# Database (PostgreSQL)
# Use the pooled URL at runtime and DIRECT_URL only when your provider requires
# a separate non-pooled connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL=""
# Optional runtime pool tuning. Existing connection_limit/pool_timeout values
# inside DATABASE_URL take precedence over these defaults.
PRISMA_CONNECTION_LIMIT="5"
PRISMA_POOL_TIMEOUT_SECONDS="20"

# Auth.js
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Keep the previous value temporarily during secret rotation; otherwise leave empty.
AUTH_SECRET_PREVIOUS=""
AUTH_URL="https://app.example.com"
APP_URL="https://app.example.com"

# Credential encryption (WordPress application passwords)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-characters"

# Cloudflare R2 — VIDEO (optional: movie thumbnails/previews, actor photos)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_HOSTNAME=""
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Cloudflare R2 — DOUJIN/COMIC (optional: comic covers + chapter page images)
# A separate bucket/credential set from the video block above by design —
# never share a bucket between the two.
R2_DOUJIN_ACCOUNT_ID=""
R2_DOUJIN_ACCESS_KEY_ID=""
R2_DOUJIN_SECRET_ACCESS_KEY=""
R2_DOUJIN_BUCKET_NAME=""
R2_DOUJIN_PUBLIC_HOSTNAME=""

# Bunny.net Stream (optional: upload, transcode, and HLS delivery)
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
BUNNY_CDN_HOST=""
# Account-level key for Allowed Referrers; this is not the Stream library key.
BUNNY_ACCOUNT_API_KEY=""
AURUM_PUBLIC_HOSTNAME="app.example.com"

# Shared cache / rate limiting (optional)
# Upstash takes precedence when both an Upstash pair and REDIS_URL are set.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# Hybrid HLS CDN + WebRTC P2P (optional)
NEXT_PUBLIC_P2P_ENABLED="false"
NEXT_PUBLIC_P2P_TRACKER_URLS=""
TRACKER_PORT="8000"
TRACKER_HOST="0.0.0.0"
TRACKER_ALLOWED_ORIGINS=""
TRACKER_TRUST_PROXY="true"
TRACKER_INTERVAL_MS="120000"

# Internal automation (optional). Use at least 16 random characters when set.
SYSTEM_API_KEY=""

# Seed/admin helper scripts (optional; do not use these placeholder credentials)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Administrator"

NODE_ENV="production"

# PromptPay preparation: disabled by default. Sandbox works in development/test only.
# Never paste real credentials into this example or use NEXT_PUBLIC_ for keys.
# See docs/PROMPTPAY-SETUP.md. Live mode is intentionally unsupported in this release.
ADS_PROMPTPAY_MODE="off"
TWOC2P_MERCHANT_ID=""
TWOC2P_SECRET_KEY=""
PAYMENTS_PUBLIC_ORIGIN=""

# Service operations: external delivery stays OFF until accounts/domains are verified.
SERVICE_EMAIL_ENABLED=false
CF_EMAIL_ACCOUNT_ID=""
CF_EMAIL_API_TOKEN=""
SERVICE_EMAIL_FROM=""
SERVICE_PUBLIC_ORIGIN="https://aurum123.com"
# Independent random 32+ character scheduler secret; never expose in browser or URL.
SERVICE_WORKER_SECRET=""
SERVICE_WORKER_ORIGIN="http://127.0.0.1:3000"
# Confirm with 2C2P merchant support. Do not assume the timestamp timezone.
TWOC2P_TRANSACTION_UTC_OFFSET=""
ADS_UPLOAD_QUOTA_MB=1024
# Attachments: use a separate PRIVATE R2 bucket, never the public media bucket.
# Production: r2; local development may retain local filesystem storage.
ADS_UPLOAD_STORAGE=local
ADS_R2_BUCKET_NAME=
ADS_R2_PRIVATE_CONFIRMED=false
# Alternative to SERVICE_WORKER_SECRET; server-only mounted file, never NEXT_PUBLIC.
# SERVICE_WORKER_SECRET_FILE=/run/secrets/aurum/service-worker-secret
# Hosting scheduler guard: enable only after migration and worker canary.
SERVICE_WORKER_ENABLED=false
# Optional legacy local attachments directory when switching to R2.
# ADS_UPLOAD_DIR=/data/ads-uploads

STRIPE_ENABLED=false
# Dedicated test DB only. Recovery continues even when new Stripe payments are disabled.
STRIPE_RECONCILIATION_ENABLED=false

STRIPE_ENVIRONMENT=sandbox

STRIPE_ACCOUNT_ID=

STRIPE_SECRET_KEY=

STRIPE_WEBHOOK_SECRET=

STRIPE_PUBLIC_BASE_URL=http://localhost:3000

STRIPE_SANDBOX_DB_CONFIRMED=false

# Optional management hostname cutover. Keep disabled until staging/TLS/auth checks pass.
MANAGEMENT_HOST_ENABLED=false
MANAGEMENT_APP_ORIGIN=https://system-management.aurum123.com
PUBLIC_APP_ORIGIN=https://aurum123.com

# Server-only analytics. Property map: {"SITE_ID":{"property":"sc-domain:example.com","account":"ownerA"}}
SEARCH_CONSOLE_PROPERTIES_JSON={}
# Account map: {"ownerA":{"client_email":"service-account email","private_key":"PEM private key"}}
# Store the real value as an environment secret; never commit it.
SEARCH_CONSOLE_ACCOUNTS_JSON={}
SITE_ANALYTICS_ORIGIN=https://aurum123.com
# Optional Monitor Panel (server-only; never expose source tokens to browsers)
MONITOR_REDIS_URL=""
MONITOR_SOURCES_JSON="[]"
