# Database (PostgreSQL)
# Use the pooled URL at runtime and DIRECT_URL only when your provider requires
# a separate non-pooled connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL=""

# Auth.js
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Keep the previous value temporarily during secret rotation; otherwise leave empty.
AUTH_SECRET_PREVIOUS=""
AUTH_URL="https://app.example.com"
APP_URL="https://app.example.com"

# Credential encryption (WordPress application passwords)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-characters"

# Cloudflare R2 (optional: images and thumbnails)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_HOSTNAME=""
NEXT_PUBLIC_R2_PUBLIC_URL=""

# Bunny.net Stream (optional: upload, transcode, and HLS delivery)
BUNNY_LIBRARY_ID=""
BUNNY_API_KEY=""
BUNNY_CDN_HOST=""
# Account-level key for Allowed Referrers; this is not the Stream library key.
BUNNY_ACCOUNT_API_KEY=""
AURUM_PUBLIC_HOSTNAME="app.example.com"

# Shared cache / rate limiting (optional)
# Upstash takes precedence when both an Upstash pair and REDIS_URL are set.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# Hybrid HLS CDN + WebRTC P2P (optional)
NEXT_PUBLIC_P2P_ENABLED="false"
NEXT_PUBLIC_P2P_TRACKER_URLS=""
TRACKER_PORT="8000"
TRACKER_HOST="0.0.0.0"
TRACKER_ALLOWED_ORIGINS=""
TRACKER_TRUST_PROXY="true"
TRACKER_INTERVAL_MS="120000"

# Internal automation (optional). Use at least 16 random characters when set.
SYSTEM_API_KEY=""

# Seed/admin helper scripts (optional; do not use these placeholder credentials)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Administrator"

NODE_ENV="production"
